# Therapeutica - Task Flow
# Copy this file to .env.local for local development. Never commit real secrets.
VITE_SUPABASE_URL=https://csubegotswfskibzscch.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICAVEL_DO_NOVO_PROJETO

# Optional fallback names used by server/dev code paths.
SUPABASE_URL=https://csubegotswfskibzscch.supabase.co
SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICAVEL_DO_NOVO_PROJETO

# Server-only secrets. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_DO_NOVO_PROJETO
GEMINI_API_KEY=SUA_CHAVE_GEMINI
GEMINI_MODEL=gemini-3.5-flash

# Google integrations remain disabled until credentials and redirect URLs are configured.
VITE_ENABLE_GOOGLE_AUTH=false
GOOGLE_OAUTH_CLIENT_ID=SEU_CLIENT_ID_GOOGLE
GOOGLE_OAUTH_CLIENT_SECRET=SEU_CLIENT_SECRET_GOOGLE
GOOGLE_SHARED_CALENDAR_ID=SEU_CALENDARIO@group.calendar.google.com
TASKFLOW_APP_URL=https://SEU_DOMINIO
INVITE_REDIRECT_URL=https://SEU_DOMINIO/auth?invite=1

# Meta/Instagram Edge Functions.
META_APP_ID=SEU_META_APP_ID
META_APP_SECRET=SEU_META_APP_SECRET
CRON_SECRET=GERE_UM_SEGREDO_FORTE
